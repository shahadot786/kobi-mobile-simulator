    "" : {

    },
    "%@, %@" : {
      "comment" : "A label that combines the name of the active device with the current orientation (portrait or landscape).",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@, %lld × %lld" : {
      "comment" : "A button that shows more information about a device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$lld × %4$lld"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "A label that reads \"Device details\" followed by the name of the device. The argument is the string “accessibility.device.details”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: %lld by %lld" : {
      "comment" : "A label displaying the viewport size of the simulator. The first argument is the string “accessibility.telemetry.viewport”. The second argument is the height of the viewport.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld by %3$lld"
          }
        }
      }
    },
    "+%lld" : {
      "comment" : "A label that shows the number of additional devices in a workspace. The argument is the number of additional devices.",
